---
import "../styles/global.css";

// const response = await fetch("http://localhost:3001/posts");
// const data = await response.json();
// console.log(response.status, data);

const API = "http://localhost:3001";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <main class="mx-auto max-w-2xl p-8">
      <h1>Express Backend Demo</h1>

      <div class="mt-6 grid grid-col-2 gap-3">
        <button
          id="btn-list"
          class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
        >
          GET /posts
        </button>
        <button
          class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
        >
          GET /posts/1
        </button>
        <button
          id="btn-create"
          class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
        >
          POST /posts
        </button>
        <button
          class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
        >
          PUT /posts
        </button>
        <button
          class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
        >
          PATCH /posts
        </button>
        <button
          class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
        >
          DELETE /posts
        </button>
      </div>

      <h2>Response</h2>
      <pre
        id="output"
        class="mt-2 overflow-auto rounded bg-gray-900 p-4 text-sm text-green-300">
		click a button to etc tetcc
	  </pre>
    </main>

    <script is:inline define:vars={{ API }}>
      const output = document.getElementById("output");

      function showResponse(status, data) {
        output.textContent = `Status: ${status}\n\n${JSON.stringify(data, null, 2)}`;
      }

      async function getAllPosts() {
        output.textContent = "loading....";

        const url = API + "/posts";
        const response = await fetch(url);
        const data = await response.json();
        // console.log(data);

        showResponse(response.status, data);
      }

      async function createPost() {
        output.textContent = "loading....";

        //usually this is going to be coming from from user input
        const newPost = {
          title: "New post",
          body: new Date().toISOString(),
          userId: 234,
        };

        const url = `${API}/posts`;
        fetch(url, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(newPost),
        })
          //   .then((response) => console.log(response.status))
          .then((response) => response.json())
          //   .then((data) => console.log(data.status))
          .then((data) => {
            showResponse(201, data);
          })
          .catch((error) => {
            output.textContent = `Error: ${error.message}`;
          });
      }

      document
        .getElementById("btn-list")
        .addEventListener("click", getAllPosts);

      document
        .getElementById("btn-create")
        .addEventListener("click", createPost);
    </script>
  </body>
</html>
