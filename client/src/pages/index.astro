---
import "../styles/global.css";

// const response = await fetch("http://localhost:3001/posts");
// const data = await response.json();
// console.log(response.status, data);

const API = "http://localhost:3001";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body class="min-h-screen bg-gray-50 text-gray-900">
		<main class="mx-auto max-w-2xl p-8">
			<h1>Express Backend Demo</h1>

			<div class="mt-6 rounded bg-gray-200 p-4">
				<h2 class="mb-2 font-bold text-gray-700">Post Form</h2>

				<label class="text-xs font-semibold text-gray-500 mb-1">Post ID (PUT, PATCH, DELETE)</label>
				<input
					id="input-id"
					type="number"
					placeholder="Post ID"
					class="mb-3 block w-full rounded p-2 border border-gray-300"
				/>
				<label class="text-xs font-semibold text-gray-500 mb-1">Content (POST, PUT, PATCH)</label>
				<input
					id="input-title"
					type="text"
					placeholder="Title"
					class="mb-2 block w-full rounded p-2 border border-gray-300"
				/>
				<input
					id="input-body"
					type="text"
					placeholder="Body"
					class="mb-2 block w-full rounded p-2 border border-gray-300"
				/>
				<input
					id="input-userid"
					type="number"
					placeholder="User ID"
					class="mb-2 block w-full rounded p-2 border border-gray-300"
				/>
			</div>

			<div class="mt-6 grid grid-col-2 gap-3">
				<button
					id="btn-list"
					class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
				>
					GET /posts
				</button>
				<button
					id="btn-get-one"
					class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
				>
					GET /posts/1
				</button>
				<button
					id="btn-create"
					class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
				>
					POST /posts
				</button>
				<button
					class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
				>
					PUT /posts
				</button>
				<button
					class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
				>
					PATCH /posts
				</button>
				<button
          id="btn-delete"
					class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
				>
					DELETE /posts
				</button>
			</div>

			<h2>Response</h2>
			<pre
				id="output"
				class="mt-2 overflow-auto rounded bg-gray-900 p-4 text-sm text-green-300">
		click a button to etc tetcc
	  </pre>
		</main>

		<script is:inline define:vars={{ API }}>
			const output = document.getElementById("output");

			function showResponse(status, data) {
				output.textContent = `Status: ${status}\n\n${JSON.stringify(data, null, 2)}`;
			}

			async function getAllPosts() {
				output.textContent = "loading....";

				const url = API + "/posts";
				const response = await fetch(url);
				const data = await response.json();
				console.log(data);

				showResponse(response.status, data);
			}

			async function getOnePost() {
				const url = `${API}/posts/1`;
				const response = await fetch(url);
				const post = await response.json();
				console.log(post);

				showResponse(response.status, post);
			}

			async function createPost() {
				output.textContent = "loading....";
				try {
					const title = document.getElementById("input-title").value;
					const body = document.getElementById("input-body").value;
					const userid = Number(document.getElementById("input-userid").value);
					const newPost = {
						title: title,
						body: body,
						userId: userid,
					};

					const url = `${API}/posts`;
					const response = await fetch(url, {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(newPost),
					});
					const data = await response.json();

					showResponse(response.status, data);

					document.getElementById("input-title").value = "";
					document.getElementById("input-body").value = "";
					document.getElementById("input-userid").value = "";
				} catch (error) {
					output.textContent = `Error: ${error.message}`;
				}
			}

      async function deletePost() {
        const id = document.getElementById("input-id").value;
				const url = `${API}/posts/${id}`;
				const response = await fetch(url, {method: "DELETE"});
				const post = await response.json();

				showResponse(response.status, post);
			}

			document
				.getElementById("btn-list")
				.addEventListener("click", getAllPosts);
			document
				.getElementById("btn-get-one")
				.addEventListener("click", getOnePost);
			document
				.getElementById("btn-create")
				.addEventListener("click", createPost);
      document
				.getElementById("btn-delete")
				.addEventListener("click", deletePost);
		</script>
	</body>
</html>
