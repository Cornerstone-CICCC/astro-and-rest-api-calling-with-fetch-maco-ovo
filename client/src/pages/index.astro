// const data = await response.json();
// console.log(response.status, data);

import "../styles/global.css";

const API = "http://localhost:3001"
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body class="min-h-screen bg-gray-50 text-gray-900">
    <main class="mx-auto max-w-2xl p-8">
      <h1>Express Backend Demo</h1>

      <div class="mt-6 grid grid-col-2 gap-3">
        <button
          class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
        >
          GET /posts
        </button>
        <button
          class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
        >
          GET /posts/1
        </button>
        <button
          class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
        >
          POST /posts
        </button>
        <button
          class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
        >
          PUT /posts
        </button>
        <button
          class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
        >
          PATCH /posts
        </button>
        <button
          class="rounded bg-blue-900 px-4 py-2 text-white hover:bg-blue-700"
        >
          DELETE /posts
        </button>
      </div>

	  <h2>Response</h2>
	  <pre class="mt-2 overflow-auto rounded bg-gray-900 p-4 text-sm text-green-300">
		click a button to etc tetcc
	  </pre>

    </main>


	<script is:inline define:vars={{ API }}>
      const output = document.getElementById("output");

      
      function showResponse(status, data){
        output.textContent = `Status: ${status}\n\n${JSON.stringify(data, null, 2)}`;
      }

      async function getAllPosts() {
        output.textContent = "loading....";

        const url = API + "/posts";
        const response = await fetch(url);
        const data = await response.json();
        // console.log(data);

        showResponse(response.status, data);
      }

      document
        .getElementById("btn-list")
        .addEventListener("click", getAllPosts);
    </script>
	</body>
</html>
